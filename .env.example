# Copia este archivo como .env y ajusta tus datos de conexión
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

DB_HOST=localhost
DB_PORT=5432
DB_NAME=compraventa_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña

# Usuario administrador de la aplicación (si ADMIN_CLAVE está vacía, nadie puede iniciar sesión)
ADMIN_USUARIO=admin
ADMIN_CLAVE=elige_una_clave
